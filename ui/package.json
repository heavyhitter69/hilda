{
  "name": "hilda-ui",
  "version": "1.0.0",
  "description": "Hilda — Dynamic Island desktop voice assistant",
  "author": "Hilda",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:backend": "cd .. && pip install -r requirements.txt && python -m PyInstaller --noconfirm --clean hilda-engine.spec",
    "build:website": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "build:folder": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win dir --publish never",
    "build:mac": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never",
    "build:linux": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --linux AppImage --publish never",
    "build:full": "npm run build:backend && npm run build:website && npm run build:mac && npm run build:linux"
  },
  "build": {
    "appId": "com.hilda.assistant",
    "productName": "Hilda",
    "artifactName": "Hilda-Setup.${ext}",
    "icon": "../hilda-ai.png",
    "directories": {
      "output": "../website/downloads"
    },
    "extraResources": [
      {
        "from": "../dist/hilda-engine",
        "to": "backend",
        "filter": ["**/*"]
      },
      {
        "from": "../.env.example",
        "to": "defaults"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": true,
      "shortcutName": "Hilda"
    },
    "files": [
      "**/*",
      "!node_modules/**/*"
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.0",
    "@dicebear/core": "^9.4.0"
  }
}

# ─────────────────────────────────────────────────────────────────────────────
# Hilda — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key (required for cloud reasoning & vision via GPT-4o)
OPENAI_API_KEY=sk-...

# How wake is detected (default: phrase match via Whisper — works with setup enrollment, no .ppn file)
# Options: whisper_phrase | porcupine
WAKE_ENGINE=whisper_phrase

# Picovoice Porcupine (optional — only if WAKE_ENGINE=porcupine)
# Get a free key at: https://console.picovoice.ai/
# Leave blank to use the built-in "computer" keyword as a placeholder
PORCUPINE_ACCESS_KEY=

# Wake word (Porcupine only):
# - Built-in keyword fallback (fast): computer | jarvis | porcupine | picovoice | etc.
PORCUPINE_KEYWORD=computer
# - Or point to a custom .ppn trained for "Hey Hilda" (recommended)
#   Example: C:\path\to\Hey-Hilda_en_windows_v3_0_0.ppn
PORCUPINE_KEYWORD_PATH=

# Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Which local model to use via Ollama
OLLAMA_MODEL=llama3

# Which OpenAI model to use for cloud reasoning
OPENAI_MODEL=gpt-4o

# Which OpenAI model to use for vision tasks
OPENAI_VISION_MODEL=gpt-4o

# WebSocket port for UI communication
WEBSOCKET_PORT=8765

# Feature flags (true/false)
USE_FAST_LANE=true
USE_CLOUD_FALLBACK=true
USE_VISION=true
USE_COQUI_TTS=false

# Speed/latency tuning
# Whisper model: tiny/base are recommended for fastest realtime STT
WHISPER_MODEL=tiny
# End-of-speech detection (lower = faster turn-taking)
STT_SILENCE_SECS=0.9
STT_SILENCE_THRESH=300
STT_MAX_RECORD_SECS=20
STT_LANGUAGE=en
# Stream LLM tokens to the UI (improves perceived latency)
STREAM_TO_UI=true

# Branding / voice
ASSISTANT_NAME=Hilda
# Optional override for “Hi {name}…” (otherwise setup wizard / user_settings.json)
USER_DISPLAY_NAME=
# For Windows SAPI voices, "zira" is a common female voice if installed
TTS_VOICE_HINT=zira

# ─────────────────────────────────────────────────────────────────────────────
# Hilda — Environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API key (required for cloud fallback & advanced vision via GPT-4o)
OPENAI_API_KEY=

# Ollama host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Which local model to use via Ollama (e.g., llama3, mistral)
OLLAMA_MODEL=llama3
OLLAMA_MAX_TOKENS=1024

# ── Feature Flags ────────────────────────────────────────────────────────────
USE_INTENT_CLASSIFIER=true
USE_CONTEXT_AWARENESS=true
USE_SEMANTIC_MEMORY=true
USE_FACT_EXTRACTION=true
USE_PROACTIVE_SUGGESTIONS=true
USE_WEB_SEARCH=true
USE_FAST_LANE=true
USE_CLOUD_FALLBACK=true
USE_VISION=true

# ── Email Integration (Optional) ─────────────────────────────────────────────
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── Settings ─────────────────────────────────────────────────────────────────
MEMORY_SEARCH_TOP_K=5
CONVERSATION_RESUME_MINUTES=30
WEBSOCKET_PORT=8765
STREAM_TO_UI=true
ASSISTANT_NAME=Hilda

# ── Voice & Audio ────────────────────────────────────────────────────────────
WHISPER_MODEL=tiny
STT_SILENCE_SECS=0.9
STT_SILENCE_THRESH=300
STT_MAX_RECORD_SECS=20
STT_LANGUAGE=en
TTS_VOICE_HINT=zira
WAKE_ENGINE=whisper_phrase

# Picovoice Porcupine (optional — only if WAKE_ENGINE=porcupine)
PORCUPINE_ACCESS_KEY=
PORCUPINE_KEYWORD=computer
PORCUPINE_KEYWORD_PATH=
